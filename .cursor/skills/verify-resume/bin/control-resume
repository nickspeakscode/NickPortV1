#!/usr/bin/env node
"use strict";

const { spawn, execFileSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { setTimeout: delay } = require("node:timers/promises");

const DEFAULT_HOST = "127.0.0.1";
const DEFAULT_PORT = 5173;
const CHROME_BIN = process.env.RESUME_VERIFY_CHROME || "/usr/bin/google-chrome-stable";

function die(message, code = 1) {
  process.stderr.write(`${message}\n`);
  process.exit(code);
}

function parseFlags(argv) {
  const flags = { _: [] };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg.startsWith("--")) {
      const key = arg.slice(2);
      const next = argv[i + 1];
      if (!next || next.startsWith("--")) {
        flags[key] = true;
      } else {
        flags[key] = next;
        i += 1;
      }
    } else {
      flags._.push(arg);
    }
  }
  return flags;
}

function runDir() {
  return process.env.RESUME_VERIFY_DIR || path.join(os.tmpdir(), "resume-verify");
}

function instancePath() {
  return path.join(runDir(), "instance.json");
}

function readInstance() {
  const file = instancePath();
  if (!fs.existsSync(file)) return null;
  return JSON.parse(fs.readFileSync(file, "utf8"));
}

function writeInstance(data) {
  fs.mkdirSync(runDir(), { recursive: true });
  fs.writeFileSync(instancePath(), `${JSON.stringify(data, null, 2)}\n`);
}

function findRepoRoot(start = process.cwd()) {
  let dir = path.resolve(start);
  while (true) {
    const pkgFile = path.join(dir, "package.json");
    if (fs.existsSync(pkgFile)) {
      const pkg = JSON.parse(fs.readFileSync(pkgFile, "utf8"));
      if (pkg.name === "personal-studio" && fs.existsSync(path.join(dir, "vite.config.js"))) {
        return dir;
      }
    }
    const parent = path.dirname(dir);
    if (parent === dir) break;
    dir = parent;
  }
  return process.env.RESUME_VERIFY_ROOT || process.cwd();
}

function pidAlive(pid) {
  if (!pid) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function listenerPids(port) {
  try {
    const out = execFileSync(
      "lsof",
      ["-iTCP:" + port, "-sTCP:LISTEN", "-n", "-P", "-t"],
      { encoding: "utf8" }
    ).trim();
    return out ? out.split(/\n/).map((line) => Number(line)).filter(Boolean) : [];
  } catch {
    return [];
  }
}

function killPid(pid, signal = "SIGTERM") {
  if (!pidAlive(pid)) return;
  try {
    process.kill(pid, signal);
  } catch {
    // already gone
  }
}

function killGroup(pid, signal = "SIGTERM") {
  if (!pid) return;
  try {
    process.kill(-pid, signal);
  } catch {
    killPid(pid, signal);
  }
}

async function waitFor(predicate, timeoutMs, label) {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    const value = await predicate();
    if (value) return value;
    await delay(150);
  }
  throw new Error(label || `Timed out after ${timeoutMs}ms`);
}

async function fetchText(url, timeoutMs = 4000) {
  const response = await fetch(url, { signal: AbortSignal.timeout(timeoutMs), redirect: "follow" });
  const body = await response.text();
  return { status: response.status, body, headers: Object.fromEntries(response.headers) };
}

function originOf(instance) {
  return instance.origin || `http://${instance.host}:${instance.port}`;
}

function requireInstance() {
  const instance = readInstance();
  if (!instance) {
    die(`No instance file at ${instancePath()}. Run control-resume launch first.`);
  }
  return instance;
}

async function cmdLaunch(flags) {
  const host = flags.host || process.env.RESUME_VERIFY_HOST || DEFAULT_HOST;
  const port = Number(flags.port || process.env.RESUME_VERIFY_PORT || DEFAULT_PORT);
  const root = findRepoRoot();
  const existing = readInstance();

  if (existing && pidAlive(existing.npmPid || existing.pid)) {
    die(`An instance is already recorded at ${originOf(existing)} (pid ${existing.npmPid || existing.pid}). Run control-resume stop first.`);
  }

  const taken = listenerPids(port);
  if (taken.length) {
    die(`Port ${port} is already in use by pid ${taken.join(",")}. Choose another --port or stop that listener. Do not drive a shared instance.`);
  }

  fs.mkdirSync(runDir(), { recursive: true });
  const logFile = path.join(runDir(), "vite.log");
  const logFd = fs.openSync(logFile, "w");
  const child = spawn(
    "npm",
    ["run", "dev", "--", "--host", host, "--port", String(port), "--strictPort"],
    {
      cwd: root,
      detached: true,
      stdio: ["ignore", logFd, logFd],
      env: process.env,
    }
  );
  fs.closeSync(logFd);
  child.unref();

  const instance = {
    npmPid: child.pid,
    host,
    port,
    origin: `http://${host}:${port}`,
    cwd: root,
    logFile,
    startedAt: new Date().toISOString(),
  };
  writeInstance(instance);

  try {
    await waitFor(async () => {
      try {
        const { status, body } = await fetchText(instance.origin);
        return status === 200 && body.includes('id="app"') ? true : null;
      } catch {
        return null;
      }
    }, 20000, `Vite did not become ready at ${instance.origin}`);
  } catch (error) {
    const log = fs.existsSync(logFile) ? fs.readFileSync(logFile, "utf8") : "";
    killGroup(child.pid, "SIGTERM");
    die(`${error.message}\n--- vite.log ---\n${log}`);
  }

  instance.listenPid = listenerPids(port)[0] || null;
  writeInstance(instance);
  process.stdout.write(`ready ${instance.origin} npmPid=${instance.npmPid} listenPid=${instance.listenPid}\n`);
}

async function cmdDoctor() {
  const instance = requireInstance();
  const origin = originOf(instance);
  const problems = [];
  const npmPid = instance.npmPid || instance.pid;

  if (!pidAlive(npmPid)) problems.push(`npm pid ${npmPid} is not running`);

  const listeners = listenerPids(instance.port);
  if (!listeners.length) {
    problems.push(`nothing is listening on ${instance.host}:${instance.port}`);
  } else if (instance.listenPid && !listeners.includes(instance.listenPid)) {
    problems.push(`port ${instance.port} is owned by pid ${listeners.join(",")}, not listenPid ${instance.listenPid}`);
  } else if (npmPid && !listeners.includes(npmPid) && instance.listenPid && !pidAlive(instance.listenPid)) {
    problems.push(`recorded listenPid ${instance.listenPid} is gone`);
  }

  const routes = ["/", "/writing/", "/library/", "/notes/"];
  const routeStatus = {};
  for (const route of routes) {
    try {
      const { status, body } = await fetchText(`${origin}${route}`);
      routeStatus[route] = status;
      if (status !== 200) problems.push(`${route} returned ${status}`);
      if (route === "/" && !body.includes("<title>Nicholas Thomas</title>")) {
        problems.push("GET / is missing the homepage title Nicholas Thomas");
      }
      if (!body.includes('id="app"')) problems.push(`${route} is missing #app`);
    } catch (error) {
      routeStatus[route] = 0;
      problems.push(`${route} failed: ${error.message}`);
    }
  }

  if (problems.length) {
    die(`doctor failed for ${origin}\n- ${problems.join("\n- ")}`);
  }

  process.stdout.write(
    [
      "ok",
      `origin=${origin}`,
      `npmPid=${npmPid}`,
      `listenPid=${instance.listenPid || listeners[0]}`,
      `routes=${routes.join(",")}`,
      `status=${routes.map((route) => routeStatus[route]).join(",")}`,
    ].join(" ") + "\n"
  );
}

async function cmdStop() {
  const instance = readInstance();
  if (!instance) {
    process.stdout.write("nothing to stop\n");
    return;
  }

  if (instance.chromePid) killPid(instance.chromePid, "SIGTERM");
  killGroup(instance.npmPid || instance.pid, "SIGTERM");
  if (instance.listenPid && instance.listenPid !== instance.npmPid) {
    killPid(instance.listenPid, "SIGTERM");
  }

  await delay(400);
  if (instance.chromePid && pidAlive(instance.chromePid)) killPid(instance.chromePid, "SIGKILL");
  if (pidAlive(instance.npmPid || instance.pid)) killGroup(instance.npmPid || instance.pid, "SIGKILL");
  if (instance.listenPid && pidAlive(instance.listenPid)) killPid(instance.listenPid, "SIGKILL");

  if (instance.chromeProfile && instance.chromeProfile.startsWith(runDir())) {
    fs.rmSync(instance.chromeProfile, { recursive: true, force: true });
  }

  fs.rmSync(instancePath(), { force: true });
  process.stdout.write(`stopped ${originOf(instance)}\n`);
}

async function cmdHttp(flags) {
  const instance = requireInstance();
  const method = (flags.method || flags._[0] || "GET").toUpperCase();
  const route = flags.path || flags._[1] || flags._[0] || "/";
  const url = route.startsWith("http") ? route : `${originOf(instance)}${route.startsWith("/") ? route : `/${route}`}`;
  const response = await fetch(url, { method, signal: AbortSignal.timeout(8000) });
  const body = await response.text();
  const outPath = flags.out;
  if (outPath) {
    fs.mkdirSync(path.dirname(path.resolve(outPath)), { recursive: true });
    fs.writeFileSync(outPath, body);
  }
  process.stdout.write(`${response.status} ${url}\n`);
  if (!flags.quiet && !outPath) process.stdout.write(body.endsWith("\n") ? body : `${body}\n`);
}

class Cdp {
  constructor(url) {
    this.url = url;
    this.nextId = 0;
    this.pending = new Map();
    this.events = [];
    this.ws = null;
  }

  async connect() {
    this.ws = new WebSocket(this.url);
    await new Promise((resolve, reject) => {
      this.ws.addEventListener("open", resolve, { once: true });
      this.ws.addEventListener("error", () => reject(new Error("CDP websocket failed")), { once: true });
    });
    this.ws.addEventListener("message", (event) => {
      const message = JSON.parse(event.data);
      if (message.id && this.pending.has(message.id)) {
        const { resolve, reject } = this.pending.get(message.id);
        this.pending.delete(message.id);
        if (message.error) reject(new Error(message.error.message || JSON.stringify(message.error)));
        else resolve(message.result);
        return;
      }
      if (message.method) this.events.push(message);
    });
  }

  send(method, params = {}) {
    const id = (this.nextId += 1);
    return new Promise((resolve, reject) => {
      this.pending.set(id, { resolve, reject });
      this.ws.send(JSON.stringify({ id, method, params }));
    });
  }

  async waitEvent(method, timeoutMs = 15000) {
    const start = Date.now();
    while (Date.now() - start < timeoutMs) {
      const index = this.events.findIndex((event) => event.method === method);
      if (index >= 0) return this.events.splice(index, 1)[0];
      await delay(50);
    }
    throw new Error(`Timed out waiting for ${method}`);
  }

  close() {
    try {
      this.ws?.close();
    } catch {
      // ignore
    }
  }
}

async function chromeJson(port, route) {
  const response = await fetch(`http://127.0.0.1:${port}${route}`, { signal: AbortSignal.timeout(3000) });
  if (!response.ok) throw new Error(`Chrome debug ${route} returned ${response.status}`);
  return response.json();
}

async function ensureChrome(instance) {
  if (instance.chromePid && pidAlive(instance.chromePid) && instance.chromePort) {
    try {
      await chromeJson(instance.chromePort, "/json/version");
      return instance;
    } catch {
      // relaunch
    }
  }

  const chromeProfile = path.join(runDir(), "chrome-profile");
  fs.rmSync(chromeProfile, { recursive: true, force: true });
  fs.mkdirSync(chromeProfile, { recursive: true });

  const debugPort = Number(process.env.RESUME_VERIFY_CDP_PORT || 9222);
  const taken = listenerPids(debugPort);
  if (taken.length && !(instance.chromePid && taken.includes(instance.chromePid))) {
    die(`Chrome debug port ${debugPort} is in use by pid ${taken.join(",")}. Set RESUME_VERIFY_CDP_PORT.`);
  }

  const windowWidth = Number(instance.viewportWidth) || 1280;
  const windowHeight = Number(instance.viewportHeight) || 800;
  const chrome = spawn(
    CHROME_BIN,
    [
      "--headless=new",
      "--no-sandbox",
      "--disable-gpu",
      "--disable-dev-shm-usage",
      "--no-first-run",
      "--no-default-browser-check",
      `--remote-debugging-port=${debugPort}`,
      `--user-data-dir=${chromeProfile}`,
      `--window-size=${windowWidth},${windowHeight}`,
      "about:blank",
    ],
    { detached: true, stdio: "ignore" }
  );
  chrome.unref();

  instance.chromePid = chrome.pid;
  instance.chromePort = debugPort;
  instance.chromeProfile = chromeProfile;
  writeInstance(instance);

  await waitFor(async () => {
    try {
      await chromeJson(debugPort, "/json/version");
      return true;
    } catch {
      return null;
    }
  }, 10000, "Chrome DevTools did not become ready");

  return instance;
}

async function pageTarget(instance) {
  const targets = await chromeJson(instance.chromePort, "/json/list");
  const page = targets.find((target) => target.type === "page") || targets[0];
  if (!page?.webSocketDebuggerUrl) throw new Error("Chrome has no page target");
  return page;
}

async function applyViewport(cdp, instance) {
  const width = Number(instance.viewportWidth);
  const height = Number(instance.viewportHeight);
  if (!width || !height) return;
  await cdp.send("Emulation.setDeviceMetricsOverride", {
    width,
    height,
    deviceScaleFactor: 1,
    mobile: width <= 900,
  });
}

async function withPage(fn) {
  const instance = requireInstance();
  await ensureChrome(instance);
  const target = await pageTarget(instance);
  const cdp = new Cdp(target.webSocketDebuggerUrl);
  await cdp.connect();
  await cdp.send("Runtime.enable");
  await cdp.send("Page.enable");
  await applyViewport(cdp, instance);
  try {
    return await fn(cdp, instance);
  } finally {
    cdp.close();
  }
}

async function evaluate(cdp, expression, awaitPromise = true) {
  const result = await cdp.send("Runtime.evaluate", {
    expression,
    awaitPromise,
    returnByValue: true,
  });
  if (result.exceptionDetails) {
    const text = result.exceptionDetails.exception?.description || result.exceptionDetails.text;
    throw new Error(text);
  }
  return result.result?.value;
}

const PAGE_HELPERS = String.raw`
function isAriaHidden(el) {
  if (el.nodeType !== Node.ELEMENT_NODE) return false;
  if (el.getAttribute("aria-hidden") === "true") return true;
  if (el.closest("[hidden]")) return true;
  const dialog = el.tagName === "DIALOG" ? el : el.closest("dialog");
  return Boolean(dialog && !dialog.open);
}
function visibleText(el) {
  if (isAriaHidden(el)) return "";
  let text = "";
  for (const node of el.childNodes) {
    if (node.nodeType === Node.TEXT_NODE) text += node.textContent;
    else if (node.nodeType === Node.ELEMENT_NODE) text += visibleText(node);
  }
  return text;
}
function accessibleName(el) {
  if (isAriaHidden(el)) return "";
  const labelled = el.getAttribute("aria-label");
  if (labelled) return labelled.trim();
  const ids = el.getAttribute("aria-labelledby");
  if (ids) {
    const joined = ids.split(/\s+/).map((id) => {
      const node = document.getElementById(id);
      return node ? visibleText(node) : "";
    }).join(" ").replace(/\s+/g, " ").trim();
    if (joined) return joined;
  }
  return visibleText(el).replace(/\s+/g, " ").trim();
}
function nameEquals(actual, expected) {
  return actual.toLowerCase() === expected.toLowerCase();
}
function nameIncludes(actual, expected) {
  return actual.toLowerCase().includes(expected.toLowerCase());
}
function matchesRole(el, role) {
  const explicit = (el.getAttribute("role") || "").toLowerCase();
  if (explicit === role) return true;
  const tag = el.tagName;
  if (role === "link") return tag === "A" && el.hasAttribute("href");
  if (role === "button") return tag === "BUTTON" || (tag === "INPUT" && /^(button|submit|reset)$/i.test(el.type));
  if (role === "navigation") return tag === "NAV";
  if (role === "heading") return /^H[1-6]$/.test(tag);
  if (role === "status") return false;
  if (role === "progressbar") return false;
  return false;
}
function findByRole(role, name) {
  const nodes = [...document.querySelectorAll("a, button, nav, h1, h2, h3, h4, [role], [aria-label]")];
  const matches = nodes.filter((el) => matchesRole(el, role));
  if (!name) return matches[0] || null;
  return matches.find((el) => nameEquals(accessibleName(el), name))
    || matches.find((el) => nameIncludes(accessibleName(el), name))
    || null;
}
function dumpAria() {
  const lines = [];
  const walk = (el, depth) => {
    if (isAriaHidden(el)) return;
    const role = (el.getAttribute("role") || "").toLowerCase()
      || (el.tagName === "A" && el.href ? "link" : "")
      || (el.tagName === "BUTTON" ? "button" : "")
      || (el.tagName === "NAV" ? "navigation" : "")
      || (el.tagName === "DIALOG" ? "dialog" : "")
      || (/^H[1-6]$/.test(el.tagName) ? "heading" : "");
    const name = accessibleName(el);
    if (role && name) {
      const heading = el.tagName.startsWith("H") ? " " + el.tagName.toLowerCase() : "";
      lines.push("  ".repeat(depth) + role + heading + ": " + name);
    }
    for (const child of el.children) walk(child, depth + (role && name ? 1 : 0));
  };
  walk(document.body, 0);
  return { title: document.title, url: location.href, lines };
}
`;

async function waitForApp(cdp, extraSelector) {
  const selector = extraSelector ? JSON.stringify(extraSelector) : "null";
  return evaluate(
    cdp,
    `(async () => {
      const extra = ${selector};
      const started = Date.now();
      while (Date.now() - started < 20000) {
        const app = document.querySelector("#app");
        const heading = document.querySelector("h1");
        const loading = [...document.querySelectorAll('[role="status"]')].some((el) => {
          if (el.hidden || el.closest("[hidden]")) return false;
          const dialog = el.closest("dialog");
          if (dialog && !dialog.open) return false;
          return /loading/i.test(el.textContent || "");
        });
        const extraOk = !extra || document.querySelector(extra);
        if (app && heading && heading.textContent.trim() && !loading && extraOk) return true;
        await new Promise((resolve) => setTimeout(resolve, 100));
      }
      throw new Error("Timed out waiting for client render");
    })()`
  );
}

function writeOut(filePath, contents, encoding = "utf8") {
  const resolved = path.resolve(filePath);
  fs.mkdirSync(path.dirname(resolved), { recursive: true });
  fs.writeFileSync(resolved, contents, encoding);
  return resolved;
}

async function cmdBrowser(flags) {
  const action = flags._[0];
  if (!action) die("Usage: control-resume browser <goto|click|text|eval|snapshot|screenshot|wait|viewport>");

  if (action === "viewport") {
    const width = Number(flags.width || flags._[1]);
    const height = Number(flags.height || flags._[2] || 844);
    if (!Number.isFinite(width) || !Number.isFinite(height) || width < 1 || height < 1) {
      die("Usage: control-resume browser viewport --width 390 --height 844");
    }
    const instance = requireInstance();
    instance.viewportWidth = Math.round(width);
    instance.viewportHeight = Math.round(height);
    writeInstance(instance);
    await withPage(async (cdp) => {
      const size = await evaluate(cdp, "({ w: innerWidth, h: innerHeight, mq: window.matchMedia('(max-width: 900px)').matches })");
      process.stdout.write(`ok viewport ${size.w}x${size.h} mobile=${size.mq}\n`);
    });
    return;
  }

  if (action === "goto") {
    const route = flags.path || flags._[1];
    if (!route) die("Usage: control-resume browser goto --path /writing/");
    await withPage(async (cdp, instance) => {
      const url = route.startsWith("http") ? route : `${originOf(instance)}${route}`;
      await cdp.send("Page.navigate", { url });
      try {
        await cdp.waitEvent("Page.loadEventFired", 15000);
      } catch {
        // keep going; client render wait is the source of truth
      }
      await waitForApp(cdp, flags.wait);
      const info = await evaluate(cdp, "({ title: document.title, url: location.href, h1: document.querySelector('h1')?.getAttribute('aria-label') || document.querySelector('h1')?.textContent?.trim() || '' })");
      process.stdout.write(`ok goto ${info.url}\ntitle=${info.title}\nh1=${info.h1}\n`);
    });
    return;
  }

  if (action === "click") {
    const role = flags.role;
    const name = flags.name;
    const selector = flags.selector;
    if (!selector && !(role && name)) {
      die('Usage: control-resume browser click --role link --name "Musings"  OR  --selector ".index-row"');
    }
    await withPage(async (cdp) => {
      const result = await evaluate(
        cdp,
        `(async () => {
          ${PAGE_HELPERS}
          const selector = ${JSON.stringify(selector || "")};
          const role = ${JSON.stringify(role || "")};
          const name = ${JSON.stringify(name || "")};
          const started = Date.now();
          let el = null;
          while (Date.now() - started < 5000) {
            el = selector ? document.querySelector(selector) : findByRole(role, name);
            if (el) break;
            await new Promise((resolve) => setTimeout(resolve, 100));
          }
          if (!el) throw new Error(selector ? "No node for " + selector : "No " + role + " named " + name);
          const clickedName = accessibleName(el);
          const clickedHref = el.href || "";
          const clickedPressed = el.getAttribute("aria-pressed");
          const clickedTag = el.tagName;
          el.click();
          return { tag: clickedTag, name: clickedName, href: clickedHref, pressed: clickedPressed };
        })()`
      );
      try {
        await cdp.waitEvent("Page.frameNavigated", 4000);
        await cdp.waitEvent("Page.loadEventFired", 15000);
      } catch {
        await delay(400);
      }
      await waitForApp(cdp).catch(() => {});
      const page = await evaluate(cdp, "({ title: document.title, url: location.href, h1: document.querySelector('h1')?.getAttribute('aria-label') || document.querySelector('h1')?.textContent?.trim() || '' })");
      process.stdout.write(`ok click ${result.tag} ${result.name}\nhref=${result.href}\nurl=${page.url}\nh1=${page.h1}\n`);
    });
    return;
  }

  if (action === "text") {
    const selector = flags.selector || flags._[1];
    if (!selector) die("Usage: control-resume browser text --selector h1");
    await withPage(async (cdp) => {
      const text = await evaluate(
        cdp,
        `(() => {
          const el = document.querySelector(${JSON.stringify(selector)});
          if (!el) throw new Error("No node for ${selector}");
          return (el.innerText || el.textContent || "").trim();
        })()`
      );
      process.stdout.write(`${text}\n`);
    });
    return;
  }

  if (action === "eval") {
    const expression = flags.js || flags._.slice(1).join(" ");
    if (!expression) die("Usage: control-resume browser eval --js \"document.title\"");
    await withPage(async (cdp) => {
      const value = await evaluate(cdp, expression);
      process.stdout.write(`${typeof value === "string" ? value : JSON.stringify(value, null, 2)}\n`);
    });
    return;
  }

  if (action === "pause") {
    const ms = Number(flags.ms || flags._[1] || 1000);
    await delay(ms);
    process.stdout.write(`ok pause ${ms}\n`);
    return;
  }

  if (action === "wait") {
    const selector = flags.selector || flags._[1];
    if (!selector) die("Usage: control-resume browser wait --selector .index-row");
    await withPage(async (cdp) => {
      await waitForApp(cdp, selector);
      process.stdout.write(`ok wait ${selector}\n`);
    });
    return;
  }

  if (action === "snapshot") {
    const out = flags.path || flags.out;
    if (!out) die("Usage: control-resume browser snapshot --aria --path .cursor/skills/verify-resume/evidence/page.aria.txt");
    await withPage(async (cdp) => {
      const dump = await evaluate(cdp, `(() => { ${PAGE_HELPERS} return dumpAria(); })()`);
      const body = [`title: ${dump.title}`, `url: ${dump.url}`, "", ...dump.lines].join("\n") + "\n";
      const saved = writeOut(out, body);
      process.stdout.write(`wrote ${saved}\n`);
    });
    return;
  }

  if (action === "screenshot") {
    const out = flags.path || flags.out;
    if (!out) die("Usage: control-resume browser screenshot --path .cursor/skills/verify-resume/evidence/page.png");
    await withPage(async (cdp) => {
      const shot = await cdp.send("Page.captureScreenshot", { format: "png", fromSurface: true });
      const saved = writeOut(out, Buffer.from(shot.data, "base64"));
      process.stdout.write(`wrote ${saved}\n`);
    });
    return;
  }

  die(`Unknown browser action: ${action}`);
}

function usage() {
  return `control-resume <launch|doctor|http|browser|stop>

  launch [--host 127.0.0.1] [--port 5173]
  doctor
  http [--method GET] --path /writing/ [--out file] [--quiet]
  browser goto --path /
  browser click --role link --name "Musings"
  browser click --selector ".index-row"
  browser text --selector h1
  browser pause --ms 2000
  browser wait --selector .index-row
  browser eval --js "document.title"
  browser snapshot --aria --path evidence/page.aria.txt
  browser screenshot --path evidence/page.png
  browser viewport --width 390 --height 844
  stop
`;
}

async function main() {
  const flags = parseFlags(process.argv.slice(2));
  const command = flags._.shift();
  if (!command || command === "help" || flags.help) {
    process.stdout.write(usage());
    return;
  }
  if (command === "launch") return cmdLaunch(flags);
  if (command === "doctor") return cmdDoctor();
  if (command === "http") return cmdHttp(flags);
  if (command === "browser") return cmdBrowser(flags);
  if (command === "stop") return cmdStop();
  die(usage());
}

main().catch((error) => die(error.stack || error.message));
