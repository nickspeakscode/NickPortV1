# Public Sanity dataset identifiers (safe to expose; used by the browser).
VITE_SANITY_PROJECT_ID=vzrug3c0
VITE_SANITY_DATASET=production

# Optional: override the market ticker source. Defaults to /api/market-data.
# VITE_MARKET_DATA_ENDPOINT=/api/market-data

# Server-only. Sanity token with Editor permission, used by /api/record-view to
# count views. Set it in Vercel; never prefix it with VITE_.
SANITY_API_WRITE_TOKEN=
